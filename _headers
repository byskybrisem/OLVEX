/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/app
  Cache-Control: no-store
/app.html
  Cache-Control: no-store
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/forgot-password
  Referrer-Policy: no-referrer
/forgot-password.html
  Referrer-Policy: no-referrer
/join
  Referrer-Policy: no-referrer
/join.html
  Referrer-Policy: no-referrer

/billing.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/billing
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
